# Copy to backend/.env for running the backend outside Docker. Never commit .env.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://pawcare:pawcare@localhost:5440/pawcare
# Comma-separated exact origins. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Which business record this deployment serves. Never taken from a client request.
BUSINESS_SLUG=pawcare-demo
# Staff account, created or updated at startup. Generate the hash locally with
#   uv run python -m app.staff hash
# Never put the password itself in configuration.
STAFF_EMAIL=
STAFF_DISPLAY_NAME=Staff
STAFF_PASSWORD_HASH=
# Voice: off (kill switch), test (no provider, no cost), or live (needs OPENAI_API_KEY).
VOICE_MODE=test
# Server-side only. Never prefix with VITE_ or commit a real value.
OPENAI_API_KEY=
VOICE_MODEL=gpt-realtime-2.1-mini
VOICE_DAILY_SESSION_LIMIT=30
VOICE_SESSIONS_PER_CLIENT_PER_HOUR=6
VOICE_MAX_SESSION_SECONDS=300
# Phone calls through OpenAI SIP (needs VOICE_MODE=live). See docs/phone.md.
PHONE_ENABLED=false
# From the OpenAI project's realtime.call.incoming webhook. Never commit a real value.
OPENAI_WEBHOOK_SECRET=
PHONE_MAX_CALL_SECONDS=600
PHONE_DAILY_CALL_LIMIT=50
PHONE_CALLS_PER_CALLER_PER_HOUR=4
# Container only: load demo data at startup.
SEED_DEMO_DATA=false
