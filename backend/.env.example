# Copy to backend/.env for running the backend outside Docker. Never commit .env.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://pawcare:pawcare@localhost:5440/pawcare
# Comma-separated exact origins. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Which business record this deployment serves. Never taken from a client request.
BUSINESS_SLUG=pawcare-demo
# Staff account, created or updated at startup. Generate the hash locally with
#   uv run python -m app.staff hash
# Never put the password itself in configuration.
STAFF_EMAIL=
STAFF_DISPLAY_NAME=Staff
STAFF_PASSWORD_HASH=
# Container only: load demo data at startup.
SEED_DEMO_DATA=false
